{
	"name": "go-conventionalcommits",
	"build": {
		"context": ".",
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/go": {
			"version": "1.24"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go"
			]
		}
	},
	"postCreateCommand": "git config core.hooksPath .githooks && go mod download"
}
